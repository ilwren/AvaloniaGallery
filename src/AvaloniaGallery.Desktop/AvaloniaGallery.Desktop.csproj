<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- The Windows executable icon. Multi-resolution .ico from the Avalonia project. -->
    <ApplicationIcon>..\AvaloniaGallery.Shared\Assets\avalonia-logo.ico</ApplicationIcon>
    <RootNamespace>AvaloniaGallery.Desktop</RootNamespace>

    <!-- One executable per desktop OS is produced from this single project by the
         release workflow, via -r win-x64 / osx-arm64 / linux-x64 and friends. -->
    <RuntimeIdentifiers>win-x64;win-arm64;osx-x64;osx-arm64;linux-x64;linux-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AvaloniaGallery.Shared\AvaloniaGallery.Shared.csproj" />
  </ItemGroup>

</Project>
