<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Page heading -->
  <Style Selector="TextBlock.pageTitle">
    <Setter Property="FontSize" Value="30" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.pageSummary">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Opacity" Value="0.8" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.sectionHeading">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,8,0,0" />
  </Style>

  <!-- "New in 12" pill -->
  <Style Selector="Border.badge">
    <Setter Property="Background" Value="{DynamicResource GalleryBadgeBrush}" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.badge > TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource GalleryBadgeForegroundBrush}" />
  </Style>

  <!-- Metadata chips under the page title -->
  <Style Selector="Border.metaChip">
    <Setter Property="Background" Value="{DynamicResource GalleryCheckerBrush}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="7,2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.metaChip > TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontFamily" Value="{DynamicResource GalleryMonoFont}" />
    <Setter Property="Opacity" Value="0.85" />
  </Style>

  <!-- Home page category tile -->
  <Style Selector="Button.tile">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="Background" Value="{DynamicResource GalleryCardBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GalleryCardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <Style Selector="Button.tile:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource GalleryCheckerBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
  </Style>

  <!--
    Navigation list.

    The pane is a single ListBox so the current page keeps a visible highlight; these
    styles give it the WinUI shape — a rounded pill with an accent bar on the left edge.
  -->
  <Style Selector="ListBox#NavList > ListBoxItem">
    <Setter Property="Padding" Value="22,6,10,6" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>

  <!-- Category rows are headers, not choices: no hover, no pointer, no highlight. -->
  <Style Selector="ListBox#NavList > ListBoxItem.navHeader">
    <Setter Property="Padding" Value="8,4,0,4" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="ListBox#NavList > ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource GalleryNavSelectedBrush}" />
  </Style>

  <!-- The accent bar that marks the selected item in WinUI's navigation pane. -->
  <Style Selector="ListBox#NavList > ListBoxItem:selected">
    <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="Padding" Value="19,6,10,6" />
  </Style>

  <Style Selector="ListBox#NavList > ListBoxItem:selected TextBlock">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!--
    The source pane keeps its dark code background in both themes, so its tab headers
    cannot inherit the theme foreground: under the light theme they would be dark text
    on a dark strip. These rules pin the contrast to the code background instead.
  -->
  <Style Selector="Border#PART_SourcePane TabItem">
    <Setter Property="Foreground" Value="#9DA5B4" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="MinHeight" Value="0" />
  </Style>

  <Style Selector="Border#PART_SourcePane TabItem:pointerover">
    <Setter Property="Foreground" Value="#D5DAE3" />
  </Style>

  <Style Selector="Border#PART_SourcePane TabItem:selected">
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Fluent draws the selected-tab underline through this template part. -->
  <Style Selector="Border#PART_SourcePane TabItem:selected /template/ Border#PART_SelectedPipe">
    <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
  </Style>

</Styles>
