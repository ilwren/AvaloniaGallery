<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Surfaces used by the gallery chrome. Defined per theme variant so the whole app
       follows the light / dark toggle without any code behind. -->
  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="GalleryCardBackgroundBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="GalleryCardFooterBrush" Color="#F7F7F7" />
      <SolidColorBrush x:Key="GalleryCardBorderBrush" Color="#E2E2E2" />
      <SolidColorBrush x:Key="GalleryCodeBackgroundBrush" Color="#1E1E1E" />
      <SolidColorBrush x:Key="GalleryNavBackgroundBrush" Color="#F3F3F3" />
      <SolidColorBrush x:Key="GalleryPageBackgroundBrush" Color="#FAFAFA" />

      <!-- Layer brushes used while a window material is active. A material is composited
           behind the window, so the shell has to stop painting solid colours over it, but
           going fully transparent leaves dark text on whatever the desktop happens to show.
           These translucent layers let the material through and still keep text readable,
           which is the same "backdrop plus layer" split WinUI uses. -->
      <SolidColorBrush x:Key="GalleryNavBackdropBrush" Color="#F3F3F3" Opacity="0.62" />
      <SolidColorBrush x:Key="GalleryPageBackdropBrush" Color="#FAFAFA" Opacity="0.55" />
      <SolidColorBrush x:Key="GalleryCheckerBrush" Color="#EFEFEF" />
      <SolidColorBrush x:Key="GalleryNavSelectedBrush" Color="#E4E4E4" />
      <SolidColorBrush x:Key="GalleryBadgeBrush" Color="#E6F2FF" />
      <SolidColorBrush x:Key="GalleryBadgeForegroundBrush" Color="#0A5BC4" />
      <SolidColorBrush x:Key="GalleryHeroBrush" Color="#EAF2FF" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="GalleryCardBackgroundBrush" Color="#2B2B2B" />
      <SolidColorBrush x:Key="GalleryCardFooterBrush" Color="#333333" />
      <SolidColorBrush x:Key="GalleryCardBorderBrush" Color="#3D3D3D" />
      <SolidColorBrush x:Key="GalleryCodeBackgroundBrush" Color="#161616" />
      <SolidColorBrush x:Key="GalleryNavBackgroundBrush" Color="#202020" />
      <SolidColorBrush x:Key="GalleryPageBackgroundBrush" Color="#272727" />

      <SolidColorBrush x:Key="GalleryNavBackdropBrush" Color="#202020" Opacity="0.62" />
      <SolidColorBrush x:Key="GalleryPageBackdropBrush" Color="#272727" Opacity="0.55" />
      <SolidColorBrush x:Key="GalleryCheckerBrush" Color="#333333" />
      <SolidColorBrush x:Key="GalleryNavSelectedBrush" Color="#3A3A3A" />
      <SolidColorBrush x:Key="GalleryBadgeBrush" Color="#16385E" />
      <SolidColorBrush x:Key="GalleryBadgeForegroundBrush" Color="#9CC9FF" />
      <SolidColorBrush x:Key="GalleryHeroBrush" Color="#1E2A3A" />
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

  <!-- A monospace stack that resolves on Windows, macOS and Linux. -->
  <FontFamily x:Key="GalleryMonoFont">Cascadia Code,Consolas,Menlo,DejaVu Sans Mono,monospace</FontFamily>

  <!-- Navigation and command glyphs -->
  <StreamGeometry x:Key="IconCode">M5.5 4.2 1.7 8l3.8 3.8-1.1 1.1L-.5 8l4.9-4.9zm5 0L14.3 8l-3.8 3.8 1.1 1.1L16.5 8l-4.9-4.9z</StreamGeometry>
  <StreamGeometry x:Key="IconCopy">M5 1h7a1 1 0 0 1 1 1v9h-1.5V2.5H5zM2.5 3.5h7a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1h-7a1 1 0 0 1-1-1v-9a1 1 0 0 1 1-1z</StreamGeometry>
  <StreamGeometry x:Key="IconSearch">M6.8 1.5a5.3 5.3 0 1 1-3.2 9.5l-2.4 2.4-1.1-1.1 2.4-2.4A5.3 5.3 0 0 1 6.8 1.5zm0 1.5a3.8 3.8 0 1 0 0 7.6 3.8 3.8 0 0 0 0-7.6z</StreamGeometry>
  <StreamGeometry x:Key="IconTheme">M8 1a7 7 0 1 0 0 14A7 7 0 0 0 8 1zm0 1.5V13.5a5.5 5.5 0 0 1 0-11z</StreamGeometry>
  <StreamGeometry x:Key="IconHome">M8 1.6l6.5 5.6-1 1.1-.7-.6V14H3.2V7.7l-.7.6-1-1.1zM8 3.6 4.7 6.4V12.5h6.6V6.4z</StreamGeometry>
  <StreamGeometry x:Key="IconLanguage">M8 1a7 7 0 1 0 0 14A7 7 0 0 0 8 1zm0 1.5c.9 0 1.9 1.4 2.4 3.5H5.6C6.1 3.9 7.1 2.5 8 2.5zM5.3 7.5h5.4a13 13 0 0 1 0 1.9H5.3a13 13 0 0 1 0-1.9zM3.8 9.4H2.1a5.5 5.5 0 0 1 0-1.9h1.7a15 15 0 0 0 0 1.9zm.3 1.5h1.5c.2 1 .5 1.9.9 2.5a5.5 5.5 0 0 1-2.4-2.5zm1.5-5.4H4.1a5.5 5.5 0 0 1 2.4-2.5c-.4.6-.7 1.5-.9 2.5zM8 13.5c-.9 0-1.9-1.4-2.4-3.5h4.8c-.5 2.1-1.5 3.5-2.4 3.5zm2.4-.1c.4-.6.7-1.5.9-2.5h1.5a5.5 5.5 0 0 1-2.4 2.5zm1.1-4H12.2a15 15 0 0 0 0-1.9h1.7a5.5 5.5 0 0 1 0 1.9zm-1.2-3.4c-.2-1-.5-1.9-.9-2.5a5.5 5.5 0 0 1 2.4 2.5z</StreamGeometry>
  <StreamGeometry x:Key="IconLink">M6.5 9.5a3 3 0 0 1 0-4.2l2-2a3 3 0 0 1 4.2 4.2l-1 1-1-1 1-1a1.5 1.5 0 0 0-2.1-2.1l-2 2a1.5 1.5 0 0 0 0 2.1zm3 -3a3 3 0 0 1 0 4.2l-2 2a3 3 0 0 1-4.2-4.2l1-1 1 1-1 1a1.5 1.5 0 0 0 2.1 2.1l2-2a1.5 1.5 0 0 0 0-2.1z</StreamGeometry>

</ResourceDictionary>
