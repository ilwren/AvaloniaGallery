<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />

    <!-- Avalonia.Headless.XUnit 12.x is built against xunit v3, so the whole test
         project has to stay on v3 to avoid duplicate FactAttribute definitions. -->
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.0" />

    <!-- Runs the tests on a real Avalonia dispatcher with a headless platform. -->
    <PackageReference Include="Avalonia.Headless.XUnit" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Skia" Version="$(AvaloniaVersion)" />

    <!-- Used by CSharpProjectorTests to compile every generated C# snippet, so the
         code shown on the C# tab is proven to build rather than merely look right. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AvaloniaGallery.Shared\AvaloniaGallery.Shared.csproj" />
  </ItemGroup>


  <ItemGroup>
    <!-- Must sit next to the test assembly or the runner will not read it. -->
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
